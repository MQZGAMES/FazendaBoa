{
  "name": "fazendaboa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fazenda Boa - jogo de fazenda pixel art mobile-first (retrato) para navegador",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
